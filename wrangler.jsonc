{
  "name": "hanzinception",
  "compatibility_date": "2026-11-01",
	"pages_build_output_dir": "./dist",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "build": {
    "command": "bun run build"
  },
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "casia-hsk1-hanzi"
		}
	]
}